{
  "id": "policy-shopping-needs-budget",
  "description": "Shopping list without budget triggers clarification",
  "setup": {
    "flags": { "CHAT_POLICY_GATING_ENABLED": "1" },
    "confirmedPreferences": {
      "room": "living room",
      "budget": null,
      "style": null,
      "color": null,
      "furniture": null
