# Names only; never commit values.
# NEXT_PUBLIC_* variables are inlined at build time.

# Set to 1 in the production deployment when the site should be indexable.
NEXT_PUBLIC_ALLOW_INDEXING=

# Set to 1 only for E2E builds (scripts/run-e2e.mjs sets it automatically).
NEXT_PUBLIC_E2E=

# Demo sign-in on /login (creates demo@furnishes.local with sample data).
# Enabled automatically outside production. Set both to 1 for `pnpm start`.
# Set ALLOW_DEMO_SIGNIN=0 to disable in any environment.
ALLOW_DEMO_SIGNIN=
NEXT_PUBLIC_ALLOW_DEMO_SIGNIN=

# PostgreSQL connection (local docker compose default below).
# Append ?connection_limit=N&pool_timeout=20 — Prisma defaults to num_cpus*2+1 PER INSTANCE.
# Size so (instances × connection_limit) stays well under Postgres max_connections.
# If the app uses PgBouncer, keep DATABASE_URL pooled and set DIRECT_URL for migrations.
# Start DB: docker compose up -d
# Host port 5433 avoids clashing with other local Postgres instances on 5432.
# DATABASE_URL="postgresql://furnishes:furnishes@127.0.0.1:5433/furnishes?schema=public"
DATABASE_URL=

# Optional direct (non-pooled) URL used only by `pnpm db:migrate:pooled`.
# Not read by prisma/schema.prisma — the app always connects via DATABASE_URL.
DIRECT_URL=

# Random secret (≥32 chars) keying the HMAC digest of session and email tokens.
# Rotating it invalidates all sessions and pending verify/reset links.
# Required in production; non-production falls back to a fixed dev pepper.
AUTH_SECRET=

# Optional. Set to 1 to force Secure cookies; 0 to force off.
# Default: Secure when APP_ORIGIN is https://
AUTH_COOKIE_SECURE=

# How many reverse-proxy hops append x-forwarded-for. A wrong value is a
# security control: too low trusts a client-supplied IP for rate limits.
TRUSTED_PROXY_HOPS=1

# Session lifetime in days (default 14).
AUTH_SESSION_TTL_DAYS=

# Block account access until the email is verified (0=off).
# Requires SMTP that reliably delivers; existing unverified users lose access
# until they verify. Resending verification stays reachable when on.
REQUIRE_EMAIL_VERIFICATION=0

# Auth abuse limits (sliding window). Defaults shown in comments.
# AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_WINDOW_MS=
AUTH_LOGIN_MAX_ATTEMPTS=
AUTH_SIGNUP_MAX_ATTEMPTS=
AUTH_FORGOT_MAX_ATTEMPTS=
AUTH_RESET_MAX_ATTEMPTS=
AUTH_VERIFY_MAX_ATTEMPTS=
AUTH_RESEND_VERIFY_MAX_ATTEMPTS=
AUTH_DEMO_MAX_ATTEMPTS=

# Per-user row / storage ceilings (0 disables a given quota).
UPLOAD_MAX_FILES_PER_USER=200
UPLOAD_MAX_BYTES_PER_USER=
HELP_REQUESTS_PER_DAY=10
PROJECTS_MAX_PER_USER=50
ROOM_PLANS_MAX_PER_USER=100
INSPIRATION_MAX_PER_USER=500
CONVERSATIONS_MAX_PER_USER=500

# Retention for SecurityEvent / AuthRateLimit / CostLog / signal purge
# (`pnpm auth:purge-retention`).
SECURITY_EVENT_RETENTION_DAYS=
AUTH_RATE_LIMIT_RETENTION_DAYS=
COST_LOG_RETENTION_DAYS=
IMPLICIT_SIGNAL_RETENTION_DAYS=
CHAT_GENERATION_RETENTION_DAYS=
WORKFLOW_EVENT_RETENTION_DAYS=

# Public origin used in verification/reset email links.
APP_ORIGIN=

# Optional release labels (shown on readiness + boot logs).
APP_VERSION=
GIT_COMMIT=

# Optional SMTP. When unset, the email adapter logs messages.
# When SMTP_HOST is set, nodemailer delivers mail (production path).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
EMAIL_FROM=

# Private object storage: local | s3
# local writes under .data/uploads (single-instance / development).
STORAGE_PROVIDER=local
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# Optional custom endpoint (Cloudflare R2, MinIO, etc.)
STORAGE_S3_ENDPOINT=
STORAGE_S3_FORCE_PATH_STYLE=

# Image generation provider: disabled | test | http
# test is allowed only when NEXT_PUBLIC_E2E=1 or NODE_ENV=test.
IMAGE_GENERATION_PROVIDER=disabled

# Generic external provider adapter (server-only; never expose to the client).
IMAGE_GENERATION_API_URL=
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_MODEL=

# Behavior and safety
IMAGE_GENERATION_MAX_CONCURRENT_PER_USER=2
IMAGE_GENERATION_DAILY_LIMIT=20
IMAGE_GENERATION_REQUEST_TIMEOUT_MS=120000
IMAGE_GENERATION_POLL_INTERVAL_MS=1500
IMAGE_GENERATION_ALLOWED_SIZES=768x768,1024x1024

# Stuck-job reconciliation (pnpm image-gen:reconcile). Status otherwise only
# advances while a browser polls, so a closed tab holds a concurrency slot.
IMAGE_GENERATION_RECONCILE_STALE_MINUTES=3
IMAGE_GENERATION_ABANDON_MINUTES=30
IMAGE_GENERATION_RECONCILE_BATCH=50

# Chat generation: local | openai
CHAT_PROVIDER=local

# Non-production only override for OpenAI misconfig fallback.
# production always fails closed when CHAT_PROVIDER=openai is misconfigured.
CHAT_ALLOW_LOCAL_FALLBACK=

# Preference extraction: heuristic | openai | disabled
PREFERENCE_EXTRACTION_PROVIDER=heuristic

# Server-only OpenAI configuration (required only when a provider is openai)
OPENAI_API_KEY=
CHAT_MODEL_PRIMARY=
CHAT_MODEL_FALLBACK=
# Optional model tiers (empty = disabled for that tier; see model-router.ts)
AI_MODEL_NANO=
AI_MODEL_MINI=
AI_MODEL_REASONING=
PREFERENCE_EXTRACTION_MODEL=

# Eval harness (docs/EVALS.md). CI uses EVAL_MODE=replay.
EVAL_MODE=replay
EVAL_JUDGE_MODEL=
EVAL_JUDGE_THRESHOLD=3.5

# Safety and operational limits
CHAT_REQUEST_TIMEOUT_MS=60000
# Latest N messages loaded into the chat page (older history stays in DB).
CHAT_BOOTSTRAP_MESSAGE_TAKE=100
CHAT_MAX_MESSAGE_LENGTH=4000
# Set to 0 to skip OpenAI moderation calls (fail-open when unset/missing key).
CHAT_MODERATION_ENABLED=
PREFERENCE_EXTRACTION_TIMEOUT_MS=20000
PREFERENCE_PROPOSAL_MAX_PER_MESSAGE=4
PREFERENCE_EXTRACTION_MIN_CONFIDENCE=0.45

# Rate limits — message counts only (0 disables that check)
CHAT_USER_MESSAGES_PER_MINUTE=20
CHAT_USER_MESSAGES_PER_DAY=200
CHAT_EXTRACTION_PER_MINUTE=30

# CostLog governance (single spend ledger). 0 disables that check.
# Session = per conversation; user/global = UTC day. Alias:
# CHAT_USER_DAILY_COST_USD=
CHAT_SESSION_COST_LIMIT_USD=2
CHAT_USER_DAILY_COST_LIMIT_USD=5
CHAT_GLOBAL_DAILY_COST_LIMIT_USD=100

# RAG over config/design-docs (0=off). Seed with SEED_RAG=1 pnpm db:seed:rag
CHAT_RAG_ENABLED=0
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_TIMEOUT_MS=20000

# Side features (suggestions / brainstorm / recommendations). 0 → routes return 503.
CHAT_SIDE_FEATURES_ENABLED=0
AI_STRUCTURED_MODEL=
AI_STRUCTURED_TIMEOUT_MS=45000
RECOMMENDATION_TOTAL_BUDGET_MS=60000

# Policy gating before layout/shopping/furniture advice (1 on by default).
CHAT_POLICY_GATING_ENABLED=1

# Design-workflow stage machine (0=off). When on, stages advance + prompt overlays.
CHAT_WORKFLOW_ENABLED=0

# Chat image attachments (private Upload ids). 0 → ignore attachmentUploadIds.
CHAT_ATTACHMENTS_ENABLED=0
CHAT_VISION_MODEL=
ATTACHMENT_GROUNDING_TIMEOUT_MS=15000

# Rolling conversation context summary (0=off). Summarizes older turns when threads grow long.
CHAT_SUMMARY_ENABLED=0
CHAT_SUMMARY_THRESHOLD=20
CHAT_SUMMARY_KEEP_RECENT=12
CHAT_SUMMARY_MAX_CHARS=2400
CHAT_SUMMARY_MODEL=
CHAT_SUMMARY_TIMEOUT_MS=20000

# Project-scoped memory block for chat / recommendations prompts (0=off).
CHAT_PROJECT_MEMORY_ENABLED=0

# Implicit behavioral signals (restate / removal / style-after-rec). 0=off.
CHAT_IMPLICIT_SIGNALS_ENABLED=0

# Room Plan + orderable readiness score. 0=off.
CHAT_ROOM_PLAN_ENABLED=0
# Copy-only "Ready to order" CTA (no checkout). 0=off.
ROOM_PLAN_ORDER_CTA_ENABLED=0

# DesignBrief export for Design page handoff. 0=off. CostLog kind: brief.
DESIGN_BRIEF_ENABLED=0

# Room photo restyle (img2img). Master flag + provider. CostLog kind: image.
CHAT_RENDERS_ENABLED=0
IMAGE_RESTYLE_PROVIDER=disabled
IMAGE_RESTYLE_MODEL=
RENDERS_DAILY_LIMIT=10

# Chat tool-calling (whitelist). 0=off. Rollout: shadow | allowlist | percent.
CHAT_TOOLS_ENABLED=0
CHAT_TOOLS_ROLLOUT=shadow
CHAT_TOOLS_ALLOWLIST=
CHAT_TOOLS_ROLLOUT_PERCENT=0
CHAT_TOOLS_TIMEOUT_MS=30000

# Copilot mode on Design/Explore (mode=copilot). 0=off.
CHAT_COPILOT_MODE_ENABLED=0

# Conversation Discover insights (LLM). 0=off. CostLog kind: insight.
CHAT_INSIGHTS_ENABLED=0

# Anonymous conversation share links. 0=off.
# Product defaults: TTL 7 days; anonymous payload = title + messages (no preference values).
CHAT_SHARE_ENABLED=0
SHARE_LINK_TTL_DAYS=7
# Anonymous GET /api/shared/[shareId] IP throttle (AuthRateLimit table).
SHARE_GET_MAX_ATTEMPTS=60
SHARE_GET_WINDOW_MS=60000
# Optional absolute origin for share URLs (falls back to request origin).
PUBLIC_APP_URL=
# Client-visible origin (same value as PUBLIC_APP_URL when set).
NEXT_PUBLIC_APP_URL=

# Image-only Studio pieces API (no mesh / Fal). 0=off.
STUDIO_ENABLED=0

# Account Canvas playground (ported 3D studio). 0=off; default on.
# Requires ANTHROPIC_API_KEY for the canvas chat dock and FAL_API_KEY
# for furniture/room mesh generation. The 3D viewer still loads without keys.
CANVAS_PLAYGROUND_ENABLED=1
ANTHROPIC_API_KEY=
FAL_API_KEY=
ENABLE_BRAIN_PIPELINE=true

# Rollout (see docs/CHAT_ROLLOUT.md)
# When CHAT_PROVIDER=openai, users outside allowlist/percent keep local chat.
CHAT_ROLLOUT_PERCENT=100
CHAT_ROLLOUT_ALLOWLIST=
# Stage 2: compare OpenAI extraction without persisting shadow proposals.
PREFERENCE_EXTRACTION_SHADOW=

# Optional legacy ETL source (dry-run default). See docs/LEGACY_CHAT_MIGRATION.md
LEGACY_DATABASE_URL=

# ── Commerce (see docs/COMMERCE.md) ──────────────────────────────────────────
# Master switch. Off hides Collections, Cart, Checkout, Orders, and Billing from
# the account rail and makes those routes 404, rather than showing a checkout
# that cannot charge.
COMMERCE_ENABLED=0

# disabled | test | stripe.
#   disabled — a cart can be filled but checkout refuses
#   test     — settles orders locally without charging; boot preflight rejects
#              this outside NEXT_PUBLIC_E2E=1 / NODE_ENV=test
#   stripe   — hosted Checkout Session over the REST API (no stripe npm
#              package). The shopper pays on Stripe's page, so no card field is
#              mounted here and card data never reaches this app.
COMMERCE_PAYMENT_PROVIDER=disabled

# Required when COMMERCE_PAYMENT_PROVIDER=stripe. Without the webhook secret,
# paid orders never advance out of pending_payment. Subscribe the endpoint to
# checkout.session.completed / .expired / .async_payment_succeeded /
# .async_payment_failed and charge.refunded.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Unpaid orders older than this (minutes) are checked against Stripe.
COMMERCE_RECONCILE_STALE_MINUTES=30

# Placeholder-grade shipping and tax, charged in the order's own currency.
# COMMERCE_TAX_PERCENT applies to goods + shipping; 0 omits the tax line.
COMMERCE_SHIPPING_FLAT_CENTS=0
COMMERCE_FREE_SHIPPING_THRESHOLD_CENTS=0
COMMERCE_TAX_PERCENT=0
COMMERCE_TAX_LABEL=Tax