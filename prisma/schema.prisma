// Phase 2 Auth + Account — minimal schema. Re-derived from legacy behavior
// (docs/legacy/production-domain-map.md); never a wholesale legacy copy.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  emailVerifiedAt   DateTime?
  displayName       String?
  memoryEnabled     Boolean   @default(true)
  activeAssistantId String    @default("eva-general")
  /// Settlement currency for catalog, cart, and orders (ISO 4217). Budget and
  /// RoomPlan carry their own planning-side currency and are not authoritative
  /// for money that is actually charged.
  currency          String    @default("SGD")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  sessions            Session[]
  emailTokens         EmailToken[]
  styleProfile        StyleProfile?
  budget              Budget?
  notificationPrefs   NotificationPrefs?
  conversations       Conversation[]
  ownedProjects       Project[]              @relation("ProjectOwner")
  projectMemberships  ProjectMember[]
  projectComments     ProjectComment[]
  projectApprovals    ProjectApproval[]
  uploads             Upload[]
  helpRequests        HelpRequest[]
  securityEvents      SecurityEvent[]
  messageFeedback     MessageFeedback[]
  imageGenerations    ImageGeneration[]
  inspirationItems    InspirationItem[]
  evaPreferences      UserPreference[]
  preferenceProposals PreferenceProposal[]
  costLogs            CostLog[]
  implicitSignals     ImplicitSignal[]
  studioPieces        FurnitureStudioPiece[]
  canvasPlaygroundProjects CanvasPlaygroundProject[]
  canvasPlaygroundConversations CanvasPlaygroundConversation[]
  roomPlans           RoomPlan[]
  cart                Cart?
  addresses           Address[]
  orders              Order[]
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  tokenDigest String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  userAgent   String?
  ipAddress   String?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailToken {
  id          String    @id @default(cuid())
  userId      String
  /// verify_email | reset_password
  purpose     String
  tokenDigest String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model StyleProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  displayName     String?
  styleWords      String?
  /// JSON: { propertyType?, mainRoom?, ceiling?, doorway? }
  preferencesJson String?
  /// Structured room footprint for policy/layout gating, e.g. { widthFeet, lengthFeet, raw }.
  roomDimensions  Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Budget {
  id              String   @id @default(cuid())
  userId          String   @unique
  minimum         Float?
  maximum         Float?
  currency        String   @default("SGD")
  /// JSON array of { name, description, amount }
  allocationsJson String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPrefs {
  id            String   @id @default(cuid())
  userId        String   @unique
  emailUpdates  Boolean  @default(false)
  emailSecurity Boolean  @default(true)
  emailDigest   Boolean  @default(true)
  inAppUpdates  Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum WorkflowStage {
  intake
  preference_capture
  clarification
  recommendation_generation
  refinement
  decision_handoff
}

model Conversation {
  id                      String        @id @default(cuid())
  userId                  String
  title                   String
  status                  String        @default("active")
  projectId               String?
  workflowStage           WorkflowStage @default(intake)
  /// Rolling summary of earlier turns (CHAT_SUMMARY_ENABLED).
  contextSummary          String?
  /// Message count covered by contextSummary.
  contextSummaryUpTo      Int?
  contextSummaryUpdatedAt DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  project               Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages              Message[]
  chatGenerations       ChatGeneration[]
  preferenceProposals   PreferenceProposal[]
  sourcePreferences     UserPreference[]       @relation("UserPreferenceSourceConversation")
  costLogs              CostLog[]
  designRecommendations DesignRecommendation[]
  workflowEvents        WorkflowEvent[]
  implicitSignals       ImplicitSignal[]
  sharedLinks           SharedProject[]

  @@index([userId, updatedAt])
}

/// Audit row for conversation design-workflow stage transitions.
model WorkflowEvent {
  id             String   @id @default(cuid())
  conversationId String
  fromStage      String
  toStage        String
  reason         String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Behavioral signals (type + category only — never message text or values).
model ImplicitSignal {
  id             String   @id @default(cuid())
  userId         String
  conversationId String
  type           String
  category       String?
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([conversationId])
}

/// Anonymous conversation share link (CHAT_SHARE_ENABLED). TTL via SHARE_LINK_TTL_DAYS.
model SharedProject {
  id             String    @id @default(cuid())
  conversationId String
  shareId        String    @unique
  createdAt      DateTime  @default(now())
  expiresAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([shareId])
}

/// Per-call LLM spend ledger (chat, extraction, embeddings, etc.).
model CostLog {
  id             String   @id @default(cuid())
  userId         String
  conversationId String?
  model          String
  /// chat | extraction | embedding | vision | recommendation | suggestion | brainstorm | insight | brief | image
  kind           String
  inputTokens    Int
  outputTokens   Int
  costUsd        Decimal  @db.Decimal(10, 6)
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([conversationId])
  @@index([createdAt])
}

/// Design archetypes recommended for a conversation (not Product SKUs).
model DesignRecommendation {
  id             String   @id @default(cuid())
  conversationId String
  stableId       String
  payload        Json
  rank           Int
  status         String   @default("active") // active | dismissed | saved
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, stableId])
  @@index([conversationId, rank])
}

/// Design-knowledge corpus chunks + embeddings for chat RAG.
model DesignDoc {
  id         String   @id @default(cuid())
  source     String
  chunkIndex Int
  content    String
  embedding  Float[]
  metadata   Json?
  createdAt  DateTime @default(now())

  @@unique([source, chunkIndex])
  @@index([source])
}

model Message {
  id              String   @id @default(cuid())
  conversationId  String
  /// user | assistant
  role            String
  content         String
  status          String   @default("complete")
  errorCode       String?
  /// Persona id used to generate assistant messages; null on user messages.
  assistantId     String?
  /// Browser-generated idempotency key for user sends. Null on assistant rows.
  clientMessageId String?
  /// Assistant reply points at the user message it answers.
  inReplyToId     String?
  createdAt       DateTime @default(now())

  conversation                 Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  inReplyTo                    Message?             @relation("MessageReply", fields: [inReplyToId], references: [id], onDelete: SetNull)
  replies                      Message[]            @relation("MessageReply")
  feedback                     MessageFeedback?
  sourcePreferences            UserPreference[]     @relation("UserPreferenceSourceMessage")
  sourcePreferenceProposals    PreferenceProposal[] @relation("PreferenceProposalSourceMessage")
  displayPreferenceProposals   PreferenceProposal[] @relation("PreferenceProposalDisplayMessage")
  generationAsUserMessage      ChatGeneration?      @relation("GenerationUserMessage")
  generationAsAssistantMessage ChatGeneration?      @relation("GenerationAssistantMessage")

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([inReplyToId])
}

/// Backend-only generation ledger. No dedicated UI surface.
model ChatGeneration {
  id                 String    @id @default(cuid())
  conversationId     String
  userMessageId      String    @unique
  assistantMessageId String?   @unique
  provider           String
  model              String?
  /// pending | complete | failed
  status             String
  errorCode          String?
  requestId          String?
  promptTokens       Int?
  completionTokens   Int?
  costUsd            Float?
  startedAt          DateTime  @default(now())
  completedAt        DateTime?

  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userMessage      Message      @relation("GenerationUserMessage", fields: [userMessageId], references: [id], onDelete: Cascade)
  assistantMessage Message?     @relation("GenerationAssistantMessage", fields: [assistantMessageId], references: [id], onDelete: SetNull)

  @@index([conversationId, startedAt])
  @@index([conversationId, status])
  @@index([status, startedAt])
}

model UserPreference {
  id                   String  @id @default(cuid())
  userId               String
  category             String
  value                String
  confidence           Float   @default(1)
  source               String  @default("manual")
  sourceConversationId String?
  sourceMessageId      String?
  sourceProposalId     String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  sourceConversation Conversation?       @relation("UserPreferenceSourceConversation", fields: [sourceConversationId], references: [id], onDelete: SetNull)
  sourceMessage      Message?            @relation("UserPreferenceSourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)
  sourceProposal     PreferenceProposal? @relation("AcceptedPreferenceProposal", fields: [sourceProposalId], references: [id], onDelete: SetNull)

  @@unique([userId, category])
  @@index([userId, updatedAt])
  @@index([sourceConversationId])
  @@index([sourceMessageId])
}

model PreferenceProposal {
  id               String  @id @default(cuid())
  userId           String
  conversationId   String?
  sourceMessageId  String?
  displayMessageId String?
  /// chat | quiz
  source           String  @default("chat")

  category      String
  proposedValue String
  previousValue String?
  acceptedValue String?
  confidence    Float
  /// pending | accepted | rejected | reverted
  status        String  @default("pending")

  evidenceText  String?
  evidenceStart Int?
  evidenceEnd   Int?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  revertedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  conversation       Conversation?   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sourceMessage      Message?        @relation("PreferenceProposalSourceMessage", fields: [sourceMessageId], references: [id], onDelete: Cascade)
  displayMessage     Message?        @relation("PreferenceProposalDisplayMessage", fields: [displayMessageId], references: [id], onDelete: SetNull)
  acceptedPreference UserPreference? @relation("AcceptedPreferenceProposal")

  @@index([userId, status, createdAt])
  @@index([userId, source, status])
  @@index([conversationId, createdAt])
  @@index([sourceMessageId])
  @@index([displayMessageId])
}

model MessageFeedback {
  id        String   @id @default(cuid())
  messageId String   @unique
  userId    String
  /// up | down
  rating    String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  summary   String?
  brief     String?
  status    String   @default("planning")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner            User                   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members          ProjectMember[]
  comments         ProjectComment[]
  approvals        ProjectApproval[]
  timeline         ProjectTimelineEvent[]
  files            Upload[]
  conversations    Conversation[]
  imageGenerations ImageGeneration[]
  inspirationItems InspirationItem[]
  roomPlans        RoomPlan[]

  @@index([ownerId, updatedAt])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  /// owner | editor | viewer
  role      String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectComment {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  body      String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model ProjectApproval {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  /// pending | approved | rejected
  status    String   @default("pending")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectTimelineEvent {
  id        String   @id @default(cuid())
  projectId String
  kind      String
  summary   String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model Upload {
  id         String   @id @default(cuid())
  userId     String
  projectId  String?
  filename   String
  mimeType   String
  sizeBytes  Int
  /// pending | processing | ready | quarantined | failed
  status     String   @default("ready")
  /// user_upload | generated_image
  source     String   @default("user_upload")
  storageKey String
  createdAt  DateTime @default(now())

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  project           Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  generationOutput  ImageGeneration?      @relation("GenerationOutput")
  inspirationItems  InspirationItem[]
  studioPieceOutput FurnitureStudioPiece? @relation("StudioPieceOutput")

  @@index([userId, createdAt])
}

model ImageGeneration {
  id             String  @id @default(cuid())
  userId         String
  projectId      String?
  outputUploadId String? @unique

  prompt         String
  negativePrompt String?
  status         String  @default("queued")
  /// queued | generating | ready | failed | canceled
  provider       String
  providerJobId  String?
  /// Optional client idempotency key for conversation renders (double-click safe).
  clientRenderId String?
  width          Int
  height         Int
  errorCode      String?
  errorMessage   String?
  /// Optional structure-check JSON: { sameStructure, confidence } from post-restyle vision.
  structureCheck Json?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  completedAt DateTime?
  canceledAt  DateTime?

  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  project          Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  outputUpload     Upload?               @relation("GenerationOutput", fields: [outputUploadId], references: [id], onDelete: SetNull)
  inspirationItems InspirationItem[]
  studioPiece      FurnitureStudioPiece?

  @@unique([userId, clientRenderId])
  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([status])
}

/// Image-only furniture studio pieces (no mesh / GLB in MVP).
model FurnitureStudioPiece {
  id                String   @id @default(cuid())
  userId            String
  prompt            String
  title             String
  quality           Json
  status            String   @default("completed")
  imageGenerationId String?  @unique
  sourcePieceId     String?
  outputUploadId    String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageGeneration ImageGeneration?       @relation(fields: [imageGenerationId], references: [id], onDelete: SetNull)
  outputUpload    Upload?                @relation("StudioPieceOutput", fields: [outputUploadId], references: [id], onDelete: SetNull)
  sourcePiece     FurnitureStudioPiece?  @relation("StudioPieceLineage", fields: [sourcePieceId], references: [id], onDelete: SetNull)
  childPieces     FurnitureStudioPiece[] @relation("StudioPieceLineage")

  @@index([userId, createdAt])
  @@index([sourcePieceId])
}

/// Account Canvas playground project (3D studio state + snapshot).
/// Separate from dashboard `Project` — scoped to `/account/canvas`.
model CanvasPlaygroundProject {
  id         String   @id @default(cuid())
  ownerId    String
  name       String
  revision   Int      @default(0)
  snapshot   Json?
  blankScene Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  conversations CanvasPlaygroundConversation[]

  @@index([ownerId, updatedAt])
}

/// Canvas playground chat thread — separate from Account `/account/chat`.
model CanvasPlaygroundConversation {
  id        String   @id
  ownerId   String
  projectId String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  project  CanvasPlaygroundProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  turns    CanvasPlaygroundConversationTurn[]

  @@index([ownerId, projectId, updatedAt])
}

/// One user/assistant round-trip in a canvas playground conversation.
model CanvasPlaygroundConversationTurn {
  id             String   @id
  conversationId String
  userText       String   @default("")
  response       String   @default("")
  displayTime    String   @default("")
  metadata       Json?
  positionHint   Int      @default(0)
  createdAt      DateTime @default(now())

  conversation CanvasPlaygroundConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt, positionHint])
}

model InspirationItem {
  id                String  @id @default(cuid())
  userId            String
  projectId         String?
  uploadId          String?
  imageGenerationId String?

  title         String?
  note          String?
  roomLabel     String?
  colorsJson    String?
  materialsJson String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  upload          Upload?          @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  imageGeneration ImageGeneration? @relation(fields: [imageGenerationId], references: [id], onDelete: SetNull)

  @@unique([userId, uploadId])
  @@unique([userId, imageGenerationId])
  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([imageGenerationId])
}

/// Structured room shopping plan with orderable readiness score.
/// Dimension fields are stored for a future spatial track but unused now.
model RoomPlan {
  id             String   @id @default(cuid())
  userId         String
  projectId      String?
  name           String
  budgetCapCents Int?
  currency       String   @default("USD")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items   RoomPlanItem[]

  @@index([userId, updatedAt])
  @@index([projectId])
}

model RoomPlanItem {
  id                String   @id @default(cuid())
  roomPlanId        String
  label             String
  category          String
  /// core | secondary | accent
  priority          String   @default("core")
  /// needed | considering | decided | purchased
  status            String   @default("needed")
  budgetCents       Int?
  actualCents       Int?
  /// Stored for future spatial track; unused for fit-check now.
  widthCm           Int?
  depthCm           Int?
  heightCm          Int?
  recommendationId  String?
  inspirationItemId String?
  notes             String?
  sortOrder         Int      @default(0)
  updatedAt         DateTime @updatedAt

  plan RoomPlan @relation(fields: [roomPlanId], references: [id], onDelete: Cascade)

  @@index([roomPlanId, sortOrder])
}

model HelpRequest {
  id        String   @id @default(cuid())
  userId    String
  category  String
  message   String
  context   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String?
  /// login_success | login_failure | logout | password_reset | ...
  kind      String
  meta      String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model WaitlistSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model AuthRateLimit {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime @default(now())
}

// ── Commerce ────────────────────────────────────────────────────────────────
// Money is always integer cents (see docs/COMMERCE.md). Prices are authored per
// currency in VariantPrice rather than FX-converted at runtime, so every figure
// shown to a user traces to a stored row. LLM-generated price bands in
// DesignRecommendation are never purchasable.

/// Authored placeholder catalog. Not synced from a supplier feed.
model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  brand       String?
  category    String
  description String?
  /// draft | active | archived — only active is purchasable
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants Variant[]

  @@index([status, category])
}

model Variant {
  id        String   @id @default(cuid())
  productId String
  sku       String   @unique
  name      String
  /// in_stock | made_to_order | out_of_stock
  status    String   @default("in_stock")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  prices     VariantPrice[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId, sortOrder])
}

/// One authored price per market. A variant without a row in the shopper's
/// currency is simply not purchasable there.
model VariantPrice {
  id          String   @id @default(cuid())
  variantId   String
  /// ISO 4217, uppercase
  currency    String
  amountCents Int
  updatedAt   DateTime @updatedAt

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, currency])
}

/// One open cart per user. Currency is fixed by the first line, because an
/// order settles in a single currency.
model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  currency  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id             String   @id @default(cuid())
  cartId         String
  variantId      String
  quantity       Int      @default(1)
  /// Captured on add, so a catalog reprice never silently changes a live cart.
  unitPriceCents Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  recipient  String
  line1      String
  line2      String?
  city       String?
  postalCode String
  /// ISO 3166-1 alpha-2
  country    String
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
}

model Order {
  id     String @id @default(cuid())
  userId String
  /// Human-facing reference shown in the UI and on invoices.
  number String @unique
  /// pending_payment | paid | fulfilled | cancelled | refunded
  status String @default("pending_payment")

  currency      String
  subtotalCents Int
  shippingCents Int    @default(0)
  taxCents      Int    @default(0)
  totalCents    Int

  /// Address snapshot: the source row may later change or be deleted.
  shipRecipient  String
  shipLine1      String
  shipLine2      String?
  shipCity       String?
  shipPostalCode String
  shipCountry    String
  shipPhone      String?

  /// test | stripe — never "disabled", which refuses checkout outright.
  paymentProvider  String
  /// The reference the shopper was sent to pay against: a Checkout Session id
  /// for hosted payments. The webhook resolves an order through it.
  paymentRef       String? @unique
  /// The underlying payment intent, learned only once the session completes.
  /// Charge-level events (refunds) carry this rather than the session id, so
  /// without it a refund would match no order.
  paymentIntentRef String? @unique
  /// Client-supplied, like Message.clientMessageId. A retried place-order
  /// returns the first order instead of charging twice.
  idempotencyKey   String  @unique

  placedAt    DateTime  @default(now())
  paidAt      DateTime?
  fulfilledAt DateTime?
  cancelledAt DateTime?
  refundedAt  DateTime?
  failureCode String?
  updatedAt   DateTime  @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([userId, placedAt])
  @@index([status, placedAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  /// Nullable so order history survives a catalog deletion; sku and name are
  /// snapshots for the same reason.
  variantId String?

  sku            String
  name           String
  quantity       Int
  unitPriceCents Int
  totalCents     Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

/// Webhook replay protection. The provider's own event id is the primary key,
/// so a redelivery collides instead of applying twice.
model ProcessedPaymentEvent {
  id          String   @id
  provider    String
  kind        String
  orderId     String?
  processedAt DateTime @default(now())
}
